# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# uv
uv.lock

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checking
.mypy_cache/

# Generated datasets (do not commit — any folder under data/ except samples/)
data/generated*/
data/smoke_*/

# Trained model artifacts (do not commit large files)
artifacts/models/*.pt
artifacts/models/*.pkl
artifacts/models/*.onnx

# Benchmark outputs — only the published summary (served by the API and bundled in the UI) is committed
artifacts/benchmarks/*.json
artifacts/benchmarks/*.csv
artifacts/benchmarks/*.jpg
!artifacts/benchmarks/summary.json

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
.env.*

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/
